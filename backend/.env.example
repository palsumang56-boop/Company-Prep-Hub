# MongoDB connection string (MongoDB Atlas recommended: enables Atlas Vector Search)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Google Gemini API key, free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secret for POST /api/ai/reindex (any long random string)
ADMIN_KEY=

PORT=4000

# Optional
# CORS_ORIGIN=https://your-frontend.vercel.app   # comma-separated; default allows all origins
# GEMINI_CHAT_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMS=768
# AI_RATE_LIMIT=30        # AI chat requests per IP per 15 minutes
# AUTO_INDEX=false        # skip embedding new/changed questions on startup
